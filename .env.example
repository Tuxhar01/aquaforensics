# AquaForensics Backend Environment Configuration
# Copy this file to .env for local deployment overrides

# Host and Port configuration
HOST=0.0.0.0
PORT=8000

# SQLite Database Persistence (Hackathon / Demo Mode)
# - SQLite is used for lightweight hackathon/demo persistence.
# - The deterministic demo scenario automatically initializes and resets itself on a fresh database.
# - Note: Durable multi-instance production deployment would require a managed database such as PostgreSQL (not required for hackathon demo).
AQUAFORENSICS_DB_PATH=aquaforensics.db

# CORS Allowed Origins (comma-separated list of explicit frontend domains)
# Example for production:
CORS_ORIGINS=https://<your-vercel-domain>.vercel.app,http://localhost:3000
